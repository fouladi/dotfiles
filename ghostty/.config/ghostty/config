# Ghostty Terminal Configuration
#

# ------------- Color Scheme
theme = GruvboxDarkFar
bold-is-bright = false

# ------------- Font
font-family = "JetBrainsMono Nerd Font"
font-size = 10
adjust-cell-width = -1

# ------------- Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# ------------- Window
window-width = 120
window-height = 55
window-padding-x = 4
window-padding-y = 2
window-decoration = false

# ------------- Input
keybind = global:f11=toggle_fullscreen
# "Ghostty 1.4.0" requires at least "GTK 4.18" and "libadwaita 1.7" on Linux, which is why a native
# installation via the standard package repositories of Ubuntu 24.04 LTS is no longer directly
# supported. Latest Ghostty version for Ubuntu 24.04 is version: 1.3.1.
copy-on-select = clipboard
mouse-scroll-multiplier = 0.95
