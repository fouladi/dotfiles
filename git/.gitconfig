[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/repo/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/dotfiles/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/omarchy-setup/"]
    path = ~/.gitconfig-personal
# All repos under ~/dev-personal/ use the personal identity.
# One directory-prefix match replaces the previous per-repo entries.
[includeIf "gitdir:~/dev-personal/"]
    path = ~/.gitconfig-personal
# ─── Aliases ───────────────────────────────────────────────────────────────────
[alias]
    st = status
    ci = commit
    co = checkout
    br = branch
    sw = switch

    # ─── Log ──────────────────────────────────────────────────────────────────
    lgp = log -p
    lg  = log --pretty=oneline --topo-order --graph --abbrev-commit --all --decorate
    lgg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=short --color
    # top-10 most-changed files, all time
    lgc = "!git log --format=format: --name-only | egrep -v '^$' | sort | uniq -c | sort -rg | head -10"
    lgy = log --since=yesterday.0:00am --oneline --decorate
    # summary of what you're going to push
    lgps = log --pretty=oneline --no-merges origin..main
    lgk = log --graph --all --decorate --stat --date=iso
    lgn = log --graph --all --decorate --stat --date=iso --name-only
    # difftastic-powered log (shell alias passes args safely)
    lgd = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff \"$@\"; }; f"
    # same without shell (pure git -c style)
    lgt = "-c diff.external=difft log -p --ext-diff"
    # most-changed files in the last year
    lgcm = "!git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20"
    # top contributors (by commit count)
    lgwho = shortlog -sn --no-merges
    # files that cluster around bug-fix commits
    lgbug = "!git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20"
    # commit frequency per month (acceleration)
    lgacc = "!git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c"
    # reverts, hotfixes, rollbacks in the last year
    lgfire = "!git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback'"

    # ─── Diff ─────────────────────────────────────────────────────────────────
    df  = diff -b
    dc  = diff -b --cached
    ds  = diff -b --staged
    dft = difftool
    # files changed since branch diverged from base (default: develop)
    dfm = "!f() { git diff --name-only $(git branch --show-current) $(git merge-base $(git branch --show-current) ${1:-develop}); }; f"

    # ─── Misc ─────────────────────────────────────────────────────────────────
    pushall = push --recurse-submodules=on-demand
    id = rev-parse --short HEAD
    unstage = reset HEAD --
    rg = grep
    # branch board: ahead/behind with last-commit date
    bb = !git for-each-ref --color --sort=-committerdate --format='%(color:red)%(ahead-behind:HEAD)\t%(color:blue)%(refname:short)\t%(color:yellow)%(committerdate:relative)\t%(color:default)%(describe)' refs/heads/ --no-merged |\
        sed 's/ /\t/' | column --separator=$'\t' --table --table-columns='Ahead,Behind,Branch Name,Last Commit,Description'
[grep]
    lineNumber = true
    patternType = perl
[mergetool "nvim"]
    # define command which will be used when "nvim" is set as a merge tool: LOCAL - MERGED - REMOTE
    # :Gw! window where you execute that command will be committed and marked as a merge resolution
    # When in MERGED window use 'd2o' or 'd3o' to pull changes from LOCAL or REMOTE file
    # 'dp' in each window: LOCAL -> MERGED or MERGED <- REMOTE
    cmd = nvim -f -c \"Gvdiffsplit!\" \"$MERGED\"
[merge]
    # set "nvim" as tool for merging
    tool = nvim
    conflictstyle = diff3
[mergetool]
    # automatically launch merge tool without displaying a prompt
    prompt = false
[push]
    default = simple
    autoSetupRemote = true
[core]
    editor = vim
    pager = delta
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[interactive]
    diffFilter = delta --color-only
[pull]
    rebase = true
[delta]
    navigate = true
    light = false
    syntax-theme = Monokai Extended Bright
    plus-style = "syntax #012800"
    minus-style = "syntax #340001"
[diff]
    colorMoved = default
    tool = difftastic
    algorithm = histogram
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[commit]
    template = ~/.gitmessage
[pager]
    difftool = true
[init]
    defaultBranch = main
[fetch]
    prune = true
[rebase]
    autoStash = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[tig "color"]
    # Colors: white, black, green, magenta, blue, cyan, yellow, red, default
    cursor = black green bold
    title-blur = white blue
    title-focus = white blue bold
[tig "color.tree"]
    date = cyan default bold
