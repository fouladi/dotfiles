[user]
    # Never guess an identity from hostname; identity comes from includeIf below.
    useConfigOnly = true

# ─── Aliases ───────────────────────────────────────────────────────────────────
[alias]
    # ─── Shortcuts ────────────────────────────────────────────────────────────
    # working tree status
    st = status
    # commit staged changes
    ci = commit
    # switch branches / restore files (legacy all-in-one command)
    co = checkout
    # list, create, or delete branches
    br = branch
    # switch branches (modern replacement for checkout <branch>)
    sw = switch
    # restore files in the working tree (modern replacement for checkout -- <file>)
    rs = restore

    # ─── Log ──────────────────────────────────────────────────────────────────
    # log with the full patch of each commit
    lgp = log -p
    # one-line graph of all branches in topological order
    lg  = log --pretty=oneline --topo-order --graph --abbrev-commit --all --decorate
    # colored one-line graph: hash, refs, subject, relative date, author
    lgg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=short --color
    # top-10 most-changed files, all time
    lgc = "!git log --format=format: --name-only | grep -v '^$' | sort | uniq -c | sort -rn | head -10"
    # commits since yesterday 00:00
    lgy = log --since=yesterday.0:00am --oneline --decorate
    # summary of what you're going to push (default: upstream of current branch)
    # usage: git lgps [<ref>]
    lgps = "!f() { u=${1:-\"@{u}\"}; git log --oneline --no-merges \"$u\"..HEAD; }; f"
    # graph of all branches with per-commit file stats (+/- lines)
    lgk = log --graph --all --decorate --stat --date=iso
    # graph of all branches with stats and the names of changed files
    lgn = log --graph --all --decorate --stat --date=iso --name-only
    # log with patches rendered by difftastic (syntax-aware diff)
    lgt = -c diff.external=difft log -p --ext-diff
    # most-changed files in the last year
    lgcm = "!git log --format=format: --name-only --since='1 year ago' | grep -v '^$' | sort | uniq -c | sort -rn | head -20"
    # top contributors (by commit count)
    lgwho = shortlog -sn --no-merges
    # files that cluster around bug-fix commits
    lgbug = "!git log -i -E --grep='fix|bug|broken' --name-only --format='' | grep -v '^$' | sort | uniq -c | sort -rn | head -20"
    # commit frequency per month (acceleration)
    lgacc = "!git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c"
    # reverts, hotfixes, rollbacks in the last year
    lgfire = "!git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback'"

    # ─── Diff ─────────────────────────────────────────────────────────────────
    # unstaged changes, ignoring whitespace-amount changes
    df  = diff -b
    # staged changes, ignoring whitespace-amount changes
    dc  = diff -b --cached
    # same as dc (--staged is a synonym of --cached)
    ds  = diff -b --staged
    # open the diff in difftastic (diff.tool)
    dft = difftool
    # files changed since branch diverged from base (default: develop)
    # usage: git dfm [<base-branch>]
    dfm = "!f() { git diff --name-only \"${1:-develop}\"...HEAD; }; f"

    # ─── Misc ─────────────────────────────────────────────────────────────────
    # push, including any submodule commits that haven't been pushed yet
    pushall = push --recurse-submodules=on-demand
    # short hash of the current commit
    id = rev-parse --short HEAD
    # remove files from the index, keep working-tree changes
    # usage: git unstage <file>...
    unstage = restore --staged --
    # search tracked files (line numbers + PCRE via [grep] below)
    rg = grep
    # branch board: unmerged local branches with ahead/behind HEAD and last-commit date
    bb = "!git for-each-ref --color --sort=-committerdate --format='%(color:red)%(ahead-behind:HEAD)\t%(color:blue)%(refname:short)\t%(color:yellow)%(committerdate:relative)\t%(color:default)%(describe)' refs/heads/ --no-merged | \
        sed 's/ /\t/' | column --separator=\"$(printf '\\t')\" --table --table-columns='Ahead,Behind,Branch Name,Last Commit,Description'"

    # Fetch origin and rebase the current branch onto origin/main (syncmain)
    # or origin/<branch> (syncfrom), auto-applying fixup!/squash! commits.
    # usage: git syncmain | git syncfrom <branch>
    #
    syncmain = "!git fetch origin && git rebase --autosquash origin/main"
    syncfrom = "!f() { git fetch origin && git rebase --autosquash \"origin/$1\"; }; f"

    # add staged changes to the last commit, keep its message
    amend = commit --amend --no-edit
    # create a worktree at ./<branch> for an existing branch
    # usage: git wtc <branch>
    wtc = "!f() { git worktree add \"$PWD/$1\" \"$1\"; }; f"

[core]
    # No editor set: Git falls back to $GIT_EDITOR, $VISUAL, $EDITOR, then vi.
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    syntax-theme = Monokai Extended Bright
    plus-style = "syntax #012800"
    minus-style = "syntax #340001"
[pager]
    difftool = true

[diff]
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change
    tool = difftastic
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[merge]
    tool = nvim
    conflictstyle = zdiff3
[mergetool]
    # automatically launch merge tool without displaying a prompt
    prompt = false
    # don't leave *.orig files behind
    keepBackup = false
[mergetool "nvim"]
    # LOCAL - MERGED - REMOTE via vim-fugitive
    # :Gw! in a window commits that buffer as the merge resolution
    # In MERGED use 'd2o' / 'd3o' to pull from LOCAL / REMOTE
    # 'dp' in each window: LOCAL -> MERGED or MERGED <- REMOTE
    cmd = nvim -f -c \"Gvdiffsplit!\" \"$MERGED\"

[commit]
    template = ~/.gitmessage
    # show the diff below the commit message template
    verbose = true
[init]
    defaultBranch = main
[fetch]
    prune = true
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    followTags = true
[rebase]
    autoStash = true
    autoSquash = true
    # move stacked branch refs along when rebasing
    updateRefs = true
[rerere]
    enabled = true
    autoUpdate = true
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[grep]
    lineNumber = true
    patternType = perl
[help]
    autocorrect = prompt

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[tig "color"]
    # Colors: white, black, green, magenta, blue, cyan, yellow, red, default
    cursor = black green bold
    title-blur = white blue
    title-focus = white blue bold
[tig "color.tree"]
    date = cyan default bold

# ─── Identity (keep last so it overrides anything above) ───────────────────────
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/repo/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/dev-personal/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/dotfiles/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/omarchy-setup/"]
    path = ~/.gitconfig-personal
